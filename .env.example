# Required: generate once per checkout/worktree with `openssl rand -base64 32`
AUTH_SECRET=replace-with-generated-local-secret

# Local Docker Compose services
POSTGRES_URL=postgres://bppedia:bppedia@localhost:5432/bppedia
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=http://localhost:9200
MINIO_ACCESS_KEY=bppedia
MINIO_SECRET_KEY=bppedia-local-secret
MINIO_BUCKET=bppedia
MINIO_USE_SSL=false

# Optional for the current route foundation. Leave empty unless testing AI Gateway.
AI_GATEWAY_API_KEY=

# Unused by BPPedia. Document storage will use MinIO.
BLOB_READ_WRITE_TOKEN=
